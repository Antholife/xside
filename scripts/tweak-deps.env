# Tweak dependencies XSide builds from source and embeds (scripts/build-tweak-deps.sh).
# Licences checked at each pin (LICENSE.md of the pinned tree).
CEPHEI_REPO=https://github.com/hbang/libcephei.git
CEPHEI_TAG=2.0
CEPHEI_COMMIT=dab73cd97a4d90965468fd604aad26580049bfcd
CEPHEI_LICENSE=Apache-2.0
# Checked and not embedded in 1.2 (they stay known libraries with « Où la trouver »):
# - AltList https://github.com/opa334/AltList.git 9db09f92eff0404ae7fa9c2fe6c25ba13d5e02d7, MIT: its
#   framework is PSListController/PSSpecifier subclasses, so it links Preferences.framework, a private
#   framework the iOS SDK ships neither headers nor a link stub for (only Theos has them).
# - libroot https://github.com/opa334/libroot.git 102348f5e9360ad1f509ae4958bd3ca686347ee8, MIT: it only
#   builds libroot_dyn.a, a static library each tweak already contains. No libroot.dylib exists in it
#   (the jailbreak ships that one; libroot_dyn falls back to /var/jb without it).
# - libGCUniversal (MrGcGamer): no licence in its public repository.

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Ad-hoc signing has no team: under the hardened runtime, library validation would refuse
	     the embedded Sparkle.framework (signed ad hoc too, so "a different team"). -->
	<key>com.apple.security.cs.disable-library-validation</key><true/>
</dict>
</plist>

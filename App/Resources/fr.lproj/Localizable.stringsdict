<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>library.issue.recordsSkipped</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@apps@</string>
		<key>apps</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld app n'a pas pu être relue depuis la bibliothèque. Une copie de sauvegarde a été gardée.</string>
			<key>other</key>
			<string>%ld apps n'ont pas pu être relues depuis la bibliothèque. Une copie de sauvegarde a été gardée.</string>
		</dict>
	</dict>
	<key>popover.expires.days</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@days@</string>
		<key>days</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Expire dans %ld jour</string>
			<key>other</key>
			<string>Expire dans %ld jours</string>
		</dict>
	</dict>
	<key>popover.paused.expiresIn</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@days@</string>
		<key>days</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Rafraîchissement arrêté · expire dans %ld jour</string>
			<key>other</key>
			<string>Rafraîchissement arrêté · expire dans %ld jours</string>
		</dict>
	</dict>
	<key>install.onDevicesCount</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@devices@</string>
		<key>devices</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Installer sur %ld appareil</string>
			<key>other</key>
			<string>Installer sur %ld appareils</string>
		</dict>
	</dict>
	<key>install.options.customize.changed</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@changes@</string>
		<key>changes</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld modification</string>
			<key>other</key>
			<string>%ld modifications</string>
		</dict>
	</dict>
</dict>
</plist>

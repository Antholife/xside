<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>library.issue.recordsSkipped</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@apps@</string>
		<key>apps</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld app couldn't be read back from the library. A backup copy was kept.</string>
			<key>other</key>
			<string>%ld apps couldn't be read back from the library. A backup copy was kept.</string>
		</dict>
	</dict>
	<key>popover.expires.days</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@days@</string>
		<key>days</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Expires in %ld day</string>
			<key>other</key>
			<string>Expires in %ld days</string>
		</dict>
	</dict>
	<key>popover.paused.expiresIn</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@days@</string>
		<key>days</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Refresh stopped · expires in %ld day</string>
			<key>other</key>
			<string>Refresh stopped · expires in %ld days</string>
		</dict>
	</dict>
	<key>install.onDevicesCount</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@devices@</string>
		<key>devices</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Install on %ld device</string>
			<key>other</key>
			<string>Install on %ld devices</string>
		</dict>
	</dict>
	<key>install.options.customize.changed</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@changes@</string>
		<key>changes</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld change</string>
			<key>other</key>
			<string>%ld changes</string>
		</dict>
	</dict>
</dict>
</plist>

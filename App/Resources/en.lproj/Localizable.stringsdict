<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>library.issue.recordsSkipped</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@apps@</string>
		<key>apps</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld app couldn't be read back from the library. A backup copy was kept.</string>
			<key>other</key>
			<string>%ld apps couldn't be read back from the library. A backup copy was kept.</string>
		</dict>
	</dict>
	<key>popover.expires.days</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@days@</string>
		<key>days</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Expires in %ld day</string>
			<key>other</key>
			<string>Expires in %ld days</string>
		</dict>
	</dict>
	<key>popover.app.tweaks</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld tweak</string>
			<key>other</key>
			<string>%ld tweaks</string>
		</dict>
	</dict>
	<key>popover.paused.expiresIn</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@days@</string>
		<key>days</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Refresh stopped · expires in %ld day</string>
			<key>other</key>
			<string>Refresh stopped · expires in %ld days</string>
		</dict>
	</dict>
	<key>install.onDevicesCount</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@devices@</string>
		<key>devices</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Install on %ld device</string>
			<key>other</key>
			<string>Install on %ld devices</string>
		</dict>
	</dict>
	<key>install.options.customize.changed</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@changes@</string>
		<key>changes</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld change</string>
			<key>other</key>
			<string>%ld changes</string>
		</dict>
	</dict>
	<key>popover.pausedDevice.expiresIn</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@days@</string>
		<key>days</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>Stopped from the device · expires in %ld day</string>
			<key>other</key>
			<string>Stopped from the device · expires in %ld days</string>
		</dict>
	</dict>
	<key>popover.pausedAll.expiresIn</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@days@</string>
		<key>days</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>All refreshes paused · expires in %ld day</string>
			<key>other</key>
			<string>All refreshes paused · expires in %ld days</string>
		</dict>
	</dict>
	<key>install.summary.tweaks.count</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@tweaks@%2$#@converted@</string>
		<key>tweaks</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>None</string>
			<key>one</key>
			<string>%1$d tweak</string>
			<key>other</key>
			<string>%1$d tweaks</string>
		</dict>
		<key>converted</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string></string>
			<key>one</key>
			<string> (%2$d converted)</string>
			<key>other</key>
			<string> (%2$d converted)</string>
		</dict>
	</dict>
	<key>downloads.usedByCount</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@tweaks@ in %2$#@apps@</string>
		<key>tweaks</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%1$d tweak</string>
			<key>other</key>
			<string>%1$d tweaks</string>
		</dict>
		<key>apps</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%2$d app</string>
			<key>other</key>
			<string>%2$d apps</string>
		</dict>
	</dict>
	<key>ipaContent.count</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>ld</string>
			<key>one</key>
			<string>%ld addition to the original app</string>
			<key>other</key>
			<string>%ld additions to the original app</string>
		</dict>
	</dict>
</dict>
</plist>
